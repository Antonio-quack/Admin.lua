local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- 1. CONFIGURAÇÃO
local ADMINS = {
	["Manoamigo99"] = true -- SEU NOME JÁ ESTÁ AQUI
}
local GUI_SIZE = UDim2.new(0, 250, 0, 400)
local GUI_POS = UDim2.new(0, 15, 0.5, -200)

-- 2. CRIA O REMOTEEVENT AUTOMATICO
local KickEvent = ReplicatedStorage:FindFirstChild("AdminKickEvent")
if not KickEvent then
	KickEvent = Instance.new("RemoteEvent")
	KickEvent.Name = "AdminKickEvent"
	KickEvent.Parent = ReplicatedStorage
end

-- 3. SERVIDOR: EXECUTA O KICK DE VERDADE
KickEvent.OnServerEvent:Connect(function(adminPlayer, targetName, reason)
	if not ADMINS[adminPlayer.Name] then 
		warn("[ADMIN] " .. adminPlayer.Name .. " tentou dar kick sem permissão")
		return 
	end
	
	local targetPlayer = Players:FindFirstChild(targetName)
	if targetPlayer then
		targetPlayer:Kick(reason or "Você foi expulso por um administrador.")
		print("[ADMIN] " .. adminPlayer.Name .. " expulsou " .. targetName)
	end
end)

